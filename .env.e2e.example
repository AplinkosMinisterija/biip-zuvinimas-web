# E2E Playwright configuration — copy this file to `.env.e2e` and fill in.
# `.env.e2e` is gitignored; your credentials never get committed.

# URL the tests run against. Default = local Vite dev server that Playwright
# starts for you (yarn start on :8080). The dev server proxies /api/* to
# whatever VITE_PROXY_URL points at in your main `.env` (a staging API).
E2E_BASE_URL=http://localhost:8080

# Login credentials (email/password). This form only works on NON-production
# backends, which is exactly what the dev proxy targets. Use an account that
# has the role you want to test:
#   - OWNER / freelancer  -> can create fish stockings
#   - USER_ADMIN          -> can manage tenant users
E2E_EMAIL=
E2E_PASSWORD=

# Optional. If your account has several profiles, set the tenant (company) name
# to auto-pick on the profile selection screen. Leave empty to pick the first.
E2E_TENANT=

# Optional. Search term used to find a water body (UETK) when creating a fish
# stocking. Must return at least one result on your backend. Default: Vilnia.
E2E_WATER_BODY=Vilnia

# Optional. Milliseconds to slow each action down in headed mode so flows are
# easy to watch. e.g. 250
PWSLOWMO=
